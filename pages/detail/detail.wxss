.page{
  height:100vh;
  background:#f5f5f5;
}

.card{
  background:white;
  margin:20rpx;
  padding:20rpx;
  border-radius:16rpx;
}

.title{
  font-size:32rpx;
  font-weight:bold;
  margin-bottom:10rpx;
}

.value{
  font-size:28rpx;
  color:#666;
}

.img-box{
  display:flex;
  flex-wrap:wrap;
}

.img{
  width:200rpx;
  height:200rpx;
  margin:10rpx;
  border-radius:8rpx;
}

.video{
  width:100%;
  height:300rpx;
}