.container{
  padding:30rpx;
  background:#f5f5f5;
  min-height:100vh;
}

.card{
  background:white;
  border-radius:20rpx;
  padding:30rpx;
  box-shadow:0 2rpx 10rpx rgba(0,0,0,.1);
}

.title{
  font-size:36rpx;
  font-weight:bold;
  color:#1E90FF;
  margin-bottom:30rpx;
}

.item{
  margin:20rpx 0;
  font-size:30rpx;
}