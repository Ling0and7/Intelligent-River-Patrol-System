.container{
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:20rpx;
}

.profile{
  display:flex;
  flex-direction:column;
  align-items:center;
  margin-bottom:20rpx;
}

.avatar{
  width:120rpx;
  height:120rpx;
  border-radius:60rpx;
  margin-bottom:10rpx;
}

.nickname{
  font-size:28rpx;
  color:#333;
}

.info{
  margin-top:20rpx;
  font-size:20rpx;
  color:#666;
}