.page{
  height:100vh;
  background:#f5f5f5;
}

.card{
  background:white;
  margin:20rpx;
  padding:20rpx;
  border-radius:16rpx;
}

.title{
  font-size:32rpx;
  font-weight:bold;
  margin-bottom:20rpx;
}

.picker{
  padding:20rpx;
  border:1rpx solid #ddd;
}

.textarea{
  height:200rpx;
  border:1rpx solid #ddd;
  padding:20rpx;
}

.img-box{
  display:flex;
  flex-wrap:wrap;
}

.img{
  width:200rpx;
  height:200rpx;
  margin:10rpx;
}

.location{
  margin-top:10rpx;
  color:#666;
}

.submit{
  margin:30rpx;
  background:#1E90FF;
  color:white;
}