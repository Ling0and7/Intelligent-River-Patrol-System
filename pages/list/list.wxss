.page{
  height:100vh;
  background:#f5f5f5;
}

.card{
  background:white;
  margin:20rpx;
  padding:20rpx;
  border-radius:16rpx;
  display:flex;
}

.thumb{
  width:150rpx;
  height:150rpx;
  border-radius:8rpx;
  margin-right:20rpx;
}

.info{
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}

.type{
  font-size:32rpx;
  font-weight:bold;
}

.desc{
  font-size:28rpx;
  color:#666;
}

.time{
  font-size:24rpx;
  color:#999;
}